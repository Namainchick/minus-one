# Replicate (GPU-Trennung)
REPLICATE_API_TOKEN=
REPLICATE_DEMUCS_VERSION=   # Versions-Hash ermitteln: siehe README "Deploy" Schritt 4

# Upstash Redis (Rate-Limit + Tagesbudget) — ohne diese Vars: In-Memory (nur Dev!)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (Upload) — wird von Vercel beim Verknüpfen des Stores gesetzt
BLOB_READ_WRITE_TOKEN=

# Lokaler Demucs-Modus (Server- und Client-Flag immer gemeinsam auf "1" setzen)
LOCAL_DEMUCS=
NEXT_PUBLIC_LOCAL_UPLOAD=
DEMUCS_BIN=              # optionaler Pfad zum demucs-Binary, Default: demucs

# Optional
DAILY_SEPARATION_LIMIT=20
CRON_SECRET=
MOCK_REPLICATE=            # "1" = kein echtes Replicate (Dev/E2E)
NEXT_PUBLIC_MOCK_UPLOAD=   # "1" = kein echtes Blob (Dev/E2E)
NEXT_PUBLIC_BASE_URL=      # nur für Mock-Stems, Default http://localhost:3000
